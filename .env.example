APP_NAME="Department Enterprise Management System"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/DEMS-PHP/public
APP_TIMEZONE=Asia/Colombo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dems_php
DB_USERNAME=root
DB_PASSWORD=

# Read-only connection used by the one-time AgrarianAdmin Location migration.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=dems_legacy_hr
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=
LEGACY_LOCATION_EFFECTIVE_FROM=2026-08-10
LEGACY_OFFICER_EFFECTIVE_FROM=2026-08-11

SESSION_NAME=DEMSPHPSESSID
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900

# MFA/SMS integration boundary for the next production integration step
SMS_GATEWAY_MODE=mock
SMS_OTP_EXPIRY_SECONDS=300
SMS_OTP_RESEND_COOLDOWN_SECONDS=60
SMS_OTP_MAX_ATTEMPTS=5
