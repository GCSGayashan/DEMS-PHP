APP_NAME="Department Enterprise Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-LIVE-DOMAIN
APP_TIMEZONE=Asia/Colombo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=YOUR_PRODUCTION_DATABASE
DB_USERNAME=YOUR_APPLICATION_DB_USER
DB_PASSWORD=CHANGE_ON_LIVE_SERVER

SESSION_NAME=DEMSSESSID
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800

LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900

SMS_GATEWAY_MODE=mock
SMS_OTP_EXPIRY_SECONDS=300
SMS_OTP_RESEND_COOLDOWN_SECONDS=60
SMS_OTP_MAX_ATTEMPTS=5
